# Crie o arquivo privado .env com: rbf init
# O comando gera os tres tokens abaixo e preserva arquivos existentes.
# Este exemplo conserva os segredos vazios. Nunca publique o arquivo .env.
RBF_CONTROL_TOKEN=
RBF_WORKER_A_TOKEN=
RBF_WORKER_B_TOKEN=

# Chats Deep Agents: proxy Codex existente, protocolo /v1/responses.
# Preencha um modelo concreto disponivel na sua conta.
RBF_CODEX_PROXY_URL=http://127.0.0.1:8000/v1
RBF_CODEX_MODEL=
RBF_FIELD_URL=http://127.0.0.1:8080
RBF_CHAT_LOG_DIR=artifacts/private/chats

# Deixe vazio para o Red criar um episodio e o Blue ler o arquivo abaixo.
# Para selecionar outro episodio, use --run-id ou preencha RBF_RUN_ID.
RBF_RUN_ID=
RBF_RUN_FILE=artifacts/private/active-run.json

# Intermediario interno opcional do Field: /chat/completions.
# Configuracao separada da proxy Responses dos chats Red e Blue.
RBF_MODEL_URL=
RBF_MODEL_NAME=
RBF_MODEL_API_KEY=
# Informe precos explicitos quando configurar esse intermediario.
RBF_MODEL_INPUT_USD_PER_MILLION=0
RBF_MODEL_OUTPUT_USD_PER_MILLION=0
