# Copy configuration only when enabling an optional model broker.
# rbf init creates .env with independent random control and worker tokens.
RBF_MODEL_URL=
RBF_MODEL_NAME=
RBF_MODEL_API_KEY=
# Explicit prices are required, including zero for a free local model.
RBF_MODEL_INPUT_USD_PER_MILLION=0
RBF_MODEL_OUTPUT_USD_PER_MILLION=0
