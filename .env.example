# Crie o arquivo privado .env com: rbf init
# O comando gera os tres tokens abaixo e preserva arquivos existentes.
# Este exemplo conserva os segredos vazios. Nunca publique o arquivo .env.
RBF_CONTROL_TOKEN=
RBF_WORKER_A_TOKEN=
RBF_WORKER_B_TOKEN=

# Bancada SPIFFE/WIF opcional: veja FIELD/spiffe-wif-lab/.env.example.
# A identidade SPIFFE vem do socket do SPIRE Agent; nenhum API_KEY é usado.
