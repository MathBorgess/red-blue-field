# Crie o arquivo privado .env com: rbf init
# O comando gera os tres tokens abaixo e preserva arquivos existentes.
# Este exemplo conserva os segredos vazios. Nunca publique o arquivo .env.
RBF_CONTROL_TOKEN=
RBF_WORKER_A_TOKEN=
RBF_WORKER_B_TOKEN=

# O controlador permite S02 com alvo externo somente quando habilitado.
# O identificador conserva o mesmo ledger entre episódios e reinícios.
RBF_ENABLE_REAL_TARGET=0
RBF_REAL_TARGET_PILOT_ID=s02-pilot
# OPENAI_API_KEY pertence apenas ao worker local; não configurar na VM.
