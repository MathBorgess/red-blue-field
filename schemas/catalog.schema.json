{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "red-blue-field scenario catalog, draft 0.1.0",
  "required": [
    "schema_version",
    "status",
    "catalog_version",
    "classification_version",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "proposed_not_executed"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "classification_version": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "title",
          "phase",
          "source_ids",
          "owasp_agentic_ids",
          "mapping_status",
          "legitimate_task",
          "red_goal",
          "surface",
          "allowed_actions",
          "attack_success_oracle",
          "utility_oracle",
          "blue_control",
          "hypothesis",
          "benign_control",
          "environment",
          "terminal_conditions",
          "budget_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "mvp",
              "expansion"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SRC[0-9]{2}$"
            }
          },
          "owasp_agentic_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ASI(0[1-9]|10)$"
            }
          },
          "mapping_status": {
            "const": "project_interpretation"
          },
          "legitimate_task": {
            "type": "string",
            "minLength": 1
          },
          "red_goal": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "attack_success_oracle": {
            "type": "string",
            "minLength": 1
          },
          "utility_oracle": {
            "type": "string",
            "minLength": 1
          },
          "blue_control": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "benign_control": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "terminal_conditions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "budget_status": {
            "const": "to_be_frozen_before_execution"
          }
        }
      }
    }
  }
}
