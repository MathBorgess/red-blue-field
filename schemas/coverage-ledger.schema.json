{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audit coverage ledger — draft 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_revision",
    "status",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "status": {
      "enum": [
        "incomplete",
        "complete"
      ]
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "boundary",
          "paths",
          "status",
          "evidence_refs",
          "candidate_refs",
          "blocker"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "checked",
              "candidate",
              "blocked",
              "deferred",
              "out_of_scope"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "candidate_refs": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "units": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "checked",
                    "out_of_scope"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
